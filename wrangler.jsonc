{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "world-salary-calculator",
  "compatibility_date": "2026-09-29",
  "main": "worker.js",
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
